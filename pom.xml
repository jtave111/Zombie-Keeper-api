<?xml version="1.0" encoding="UTF-8"?>
<!--
    Merum — POM Agregador do Monorepo
    =========================================

    Este é o POM raiz do monorepo Merum. Seu papel é exclusivamente
    de AGREGADOR: ele lista os módulos Java do projeto e permite executar
    comandos Maven a partir da raiz que se propagam para todos os módulos.

    Tipo: <packaging>pom</packaging>
    Não produz nenhum artefato (JAR/WAR). Apenas orquestra o build.

    Módulos Java gerenciados:
      - Merum-Api  →  Servidor C2 Spring Boot 4 · Java 21

    Nota: Merum-Web (Next.js) e Merum-Arsenal (C++/CMake) NÃO
    são módulos Maven. Eles possuem seus próprios sistemas de build (npm e cmake).

    Comandos úteis a partir da raiz:
      ./mvnw clean package -DskipTests        Build de todos os módulos Java
      ./mvnw clean package -DskipTests -pl Merum-Api   Apenas a API
      ./mvnw spring-boot:run -pl Merum-Api             Rodar a API

    Importante: Merum-Api mantém spring-boot-starter-parent como seu
    próprio parent POM. Este POM raiz NÃO interfere no gerenciamento de
    dependências do Spring Boot — é um agregador puro sem herança de dependências.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.manager</groupId>
    <artifactId>merum-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Merum</name>
    <description>
        Merum — Plataforma C2 dual-purpose para monitoramento de infraestrutura
        e operações de segurança ofensiva autorizada. POM agregador do monorepo.
    </description>
    <packaging>pom</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!--
        Módulos Java do monorepo.
        Adicione novos módulos Java aqui conforme o projeto crescer.
        Ex: <module>Merum-Agent-Java</module>
    -->
    <modules>
        <module>Merum-Api</module>
        <!-- <module>Merum-Web</module>  Next.js — gerenciado por npm, não Maven -->
    </modules>

</project>
